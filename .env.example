# local: no API key; deterministic embeddings and extractive answers
RAG_MODE=local
EMBEDDING_PROVIDER=local
RERANKER_PROVIDER=local
INDEX_BACKEND=local
PERSISTENCE_BACKEND=local

# PostgreSQL + pgvector (Docker Compose sets these automatically).
# INDEX_BACKEND=postgres
DATABASE_URL=
# Isolated target used only by scripts/recovery_drill.py.
RECOVERY_DATABASE_URL=
PGVECTOR_COLLECTION=opspilot
EMBEDDING_DIMENSIONS=1536

# Authentication is opt-in for backward-compatible local evaluation.
# Generate a random value, do not reuse this example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ENABLED=false
AUTH_PROVIDER=local
AUTH_SECRET_KEY=local-development-only-secret-change-me
AUTH_TOKEN_MINUTES=30
AUTH_ISSUER=opspilot-rag
AUTH_AUDIENCE=opspilot-api
AUTH_STORE_PATH=data/state/users.sqlite
ACCESS_POLICY_PATH=data/security/document_access.json

# Enterprise OIDC/SSO. Map users with external_subject="<issuer>|<sub>".
# AUTH_PROVIDER=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=["RS256"]

# HTTP audit trail and fixed-window rate limiting.
AUDIT_ENABLED=false
AUDIT_STORE_PATH=data/state/audit.sqlite
AUDIT_RETENTION_DAYS=90
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# openai: set both providers to openai for a production-like demo
# RAG_MODE=openai
# EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional real second-stage reranker. First run downloads the model.
# Install with: uv sync --extra reranker
# RERANKER_PROVIDER=cross_encoder
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CROSS_ENCODER_DEVICE=cpu
CROSS_ENCODER_BATCH_SIZE=8
CROSS_ENCODER_WEIGHT=0.80

# Optional LangSmith tracing. Never commit the real key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opspilot-rag

# Low-cardinality Prometheus metrics and content-free OTLP/HTTP traces.
# Install with: uv sync --extra observability
METRICS_ENABLED=false
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=opspilot-rag
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_SAMPLE_RATIO=1.0
DEPLOYMENT_ENVIRONMENT=local

# Repeatable load gate defaults. Production targets should be calibrated
# against real model/provider latency and retained with the release report.
SLO_AVAILABILITY_TARGET=0.995
SLO_P95_LATENCY_MS=5000
SLO_MIN_REQUESTS=20

RETRIEVAL_STRATEGY=hybrid_rerank
TOP_K=4
CANDIDATE_K=12
MIN_RELEVANCE_SCORE=0.18
MIN_BM25_SCORE=0.80
MIN_LEXICAL_COVERAGE=0.12
VECTOR_WEIGHT=0.55
BM25_WEIGHT=0.45
RRF_K=60
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MAX_UPLOAD_MB=15
# For local development, keep this true
KNOWLEDGE_MUTATIONS_ENABLED=true
CHECKPOINT_PATH=data/state/checkpoints.sqlite
TICKET_CHECKPOINT_PATH=data/state/ticket_checkpoints.sqlite
TICKET_STORE_PATH=data/state/tickets.sqlite
MAX_REWRITES=1
CONVERSATION_HISTORY_LIMIT=8

# Used by the Streamlit process.
OPSPILOT_API_URL=http://127.0.0.1:8000
